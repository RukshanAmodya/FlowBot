# Google Flow URL
FLOW_URL=https://labs.google/fx/tools/flow

# Browser & Profile Settings
BROWSER_PROFILE_DIR=./browser_profile
HEADLESS=false
FLOW_DEBUG=false

# Generation Defaults
FLOW_MODEL=NANO_BANANA_2
IMAGE_COUNT=4
ASPECT_RATIO=16:9
OUTPUT_STRATEGY=single_request

# Timeouts (seconds)
GENERATION_TIMEOUT_SECONDS=300
DOWNLOAD_TIMEOUT_SECONDS=120

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=

# Storage Paths
OUTPUT_DIR=./generated
TEMP_DIR=./temp
SCREENSHOT_DIR=./screenshots
LOG_DIR=./logs
LOG_LEVEL=INFO
